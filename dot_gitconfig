[init]
	defaultBranch = main

[core]
	pager = delta

[interactive]
  diffFilter = delta --color-only

[delta]
    navigate = true

[merge]
    conflictstyle = diff3

[diff]
    colorMoved = default
[ghq]
	root = ~/workspace
[credential "https://github.com"]
	helper =
	helper = !\"$HOME/.nix-profile/bin/gh\" auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !\"$HOME/.nix-profile/bin/gh\" auth git-credential
[commit]
	gpgsign = true
